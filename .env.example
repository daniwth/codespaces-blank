# Account server (npm run server). Copy to .env and fill in.
PORT=8787
DATA_DIR=./data
# Public URL of the web app (Stripe redirects back here)
APP_URL=http://localhost:5173

# Leave STRIPE_SECRET_KEY empty to run the demo billing flow (no real charges).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs created in the Stripe dashboard
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
