# Account server (npm run server). Copy to .env and fill in.
PORT=8787
DATA_DIR=./data
# Public URL of the web app (Stripe redirects back here)
APP_URL=http://localhost:5173

# stripe | demo. Defaults to stripe when STRIPE_SECRET_KEY is set, otherwise demo
# (free instant activation). With NODE_ENV=production demo must be explicit.
BILLING_MODE=
# Number of reverse proxies in front of the server (enables X-Forwarded-For). 0 = none.
# Must equal the EXACT number of proxies: every rate limit (login, register, resend, forgot) is
# keyed by client IP. Too low: all users share the proxy's IP and its limits. Too high: clients
# can spoof their IP to evade or aim the limits.
TRUST_PROXY=0

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs created in the Stripe dashboard
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Outgoing email (verification + password reset). log | http.
# log: prints emails (with links) to the server console and adds a `devLink` to API responses;
#      the default outside production and refused when NODE_ENV=production.
# http: POSTs JSON {from, to: [addr], subject, text} to MAIL_API_URL with
#       "Authorization: Bearer MAIL_API_KEY" (Resend-style). Required in production.
MAIL_MODE=
MAIL_API_URL=
MAIL_API_KEY=
MAIL_FROM=
